# Copy to .env and edit. Used to build an HONEST User-Agent so the site
# operator can identify and contact us. Do not remove the contact.
CONTACT_EMAIL=you@example.com
PROJECT_URL=https://github.com/yourname/paliquor

# Politeness knobs (seconds). Conservative defaults; raise if asked to slow down.
MIN_REQUEST_INTERVAL=2.0
CATALOG_TTL_HOURS=168
INVENTORY_TTL_HOURS=6

# Headless browser concurrency for inventory (keep low and human-like).
BROWSER_CONCURRENCY=1
